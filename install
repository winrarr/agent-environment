#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
codex_home="${CODEX_HOME:-${HOME:?HOME is required}/.codex}"
claude_home="${CLAUDE_HOME:-${HOME:?HOME is required}/.claude}"

fail() {
  printf 'install: %s\n' "$1" >&2
  exit 1
}

ensure_link() {
  local target="$1"
  local link="$2"

  mkdir -p -- "$(dirname -- "$link")"

  if [[ -L "$link" ]]; then
    ln -sfn -- "$target" "$link"
    return
  fi

  if [[ -e "$link" ]]; then
    fail "refusing to replace unmanaged path: $link"
  fi

  ln -s -- "$target" "$link"
}

install_claude_skill() {
  local source_dir="$1"
  local skill_name
  local destination_dir
  local entry

  skill_name="$(basename -- "$source_dir")"
  destination_dir="$claude_home/skills/$skill_name"

  if [[ -L "$destination_dir" ]]; then
    rm -- "$destination_dir"
  elif [[ -e "$destination_dir" && ! -d "$destination_dir" ]]; then
    fail "refusing to replace unmanaged path: $destination_dir"
  fi

  mkdir -p -- "$destination_dir"

  for entry in SKILL.md references scripts assets; do
    if [[ -e "$source_dir/$entry" ]]; then
      ensure_link "$source_dir/$entry" "$destination_dir/$entry"
    fi
  done
}

[[ -s "$repo_dir/global-instructions.md" ]] || fail "missing or empty global-instructions.md"
[[ -d "$repo_dir/skills" ]] || fail "missing skills directory"

ensure_link "$repo_dir/global-instructions.md" "$codex_home/AGENTS.md"
ensure_link "$repo_dir/global-instructions.md" "$claude_home/CLAUDE.md"

shopt -s nullglob
for skill_dir in "$repo_dir"/skills/*; do
  [[ -d "$skill_dir" ]] || continue
  [[ -s "$skill_dir/SKILL.md" ]] || fail "missing or empty SKILL.md in $skill_dir"

  skill_name="$(basename -- "$skill_dir")"
  ensure_link "$skill_dir" "$codex_home/skills/$skill_name"
  install_claude_skill "$skill_dir"
done

printf 'Installed personal instructions and skills from %s\n' "$repo_dir"
